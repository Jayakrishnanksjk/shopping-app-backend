{
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "phonepe/pg-php-sdk-v2",
                "version": "2.0.0",
                "dist": {
                    "url": "https://phonepe.mycloudrepo.io/public/repositories/phonepe-pg-php-sdk/v2-sdk.zip",
                    "type": "zip"
                },
                "autoload": {
                    "classmap": ["/"]
                }
            }
        }
    ],
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "cartalyst/stripe-laravel": "^15.0",
        "cloudinary-labs/cloudinary-laravel": "^2.3",
        "cviebrock/eloquent-sluggable": "^10.0",
        "darkaonline/l5-swagger": "^8.6",
        "doctrine/dbal": "^3.10",
        "guzzlehttp/guzzle": "^7.2",
        "intervention/image": "^2.7",
        "jackiedo/dotenv-editor": "^2.0",
        "laravel/framework": "^10.0",
        "laravel/sanctum": "^3.2",
        "laravel/tinker": "^2.8",
        "maatwebsite/excel": "^3.1",
        "mll-lab/laravel-graphiql": "^3.0",
        "mollie/laravel-mollie": "^2.22",
        "netresearch/jsonmapper": "^4.4",
        "nuwave/lighthouse": "^6.0",
        "openai-php/client": "^0.19.0",
        "phonepe/pg-php-sdk-v2": "^2.0",
        "prettus/l5-repository": "^2.8",
        "razorpay/razorpay": "^2.8",
        "spatie/laravel-medialibrary": "^10.0.0",
        "spatie/laravel-permission": "^5.5",
        "srmklive/paypal": "^3.0",
        "stripe/stripe-php": "^10.10",
        "vlucas/phpdotenv": "^5.6",
        "webpatser/laravel-countries": "^1.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "files": [
            "app/Helpers/Helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "audit": {
        "ignore": [
            "PKSA-gh7h-hhy4-byg7",
            "PKSA-6r8f-nxsb-67bq",
            "PKSA-cv56-2228-pzr6",
            "PKSA-mwt3-h9tv-kx78",
            "PKSA-mckv-s5hg-868k",
            "PKSA-hp6n-n4kz-21wk"
        ],
        "block-insecure": false
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
